# ~/.config/muster/.env  (the installer creates it from this file; it is never committed: see .gitignore)
# KEY=value lines. Real environment variables win over this file. Empty values are ignored.
#
# You do NOT need any tokens for the default setup:
#   - GitHub uses your `gh auth login` session
#   - Jira, Google Calendar and Slack go through your claude.ai connectors (signed in inside Claude Code)
#   - spend comes from local Claude Code logs (ccusage)
# Use this file only to override settings, or if you prefer tokens over those logins.

# --- Overrides for config.toml (same meaning, same names in UPPER_CASE) ---
MUSTER_GITHUB_ORGS=
MUSTER_REVIEW_REPOS=
MUSTER_CODE_ROOT=
MUSTER_WORKTREE_GLOB=
MUSTER_NEW_AGENT=
MUSTER_SHARE_CHANNEL_ID=
MUSTER_SHARE_CHANNEL_NAME=
MUSTER_SHARE_MENTION=
MUSTER_JIRA_JQL=
MUSTER_MODEL_FETCH=

# --- Optional tokens (only if you don't use the logins above) ---
# gh reads GH_TOKEN instead of your `gh auth login` session (needs repo + read:org scopes).
GH_TOKEN=
